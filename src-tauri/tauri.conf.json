{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Oratio",
  "version": "0.1.0",
  "identifier": "dev.vox.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    },
    "windows": [
      {
        "label": "main",
        "title": "Oratio",
        "url": "index.html",
        "width": 400,
        "height": 470,
        "minWidth": 340,
        "minHeight": 380,
        "transparent": true,
        "windowEffects": {
          "effects": [
            "acrylic"
          ],
          "color": "#0a0f1978"
        },
        "visible": false
      },
      {
        "label": "overlay",
        "url": "overlay.html",
        "width": 250,
        "height": 124,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false,
        "resizable": false,
        "shadow": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../models/": "models/"
    }
  }
}
